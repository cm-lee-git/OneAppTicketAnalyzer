# Jira (hmg.atlassian.net)
JIRA_EMAIL=your-email@innocean.com
JIRA_API_TOKEN=your-jira-api-token

# Confluence (ihqdf.atlassian.net)
CONFLUENCE_EMAIL=your-email@innocean.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# Claude API (h-chat 사내 프록시)
ANTHROPIC_API_KEY=your-hchat-api-key
ANTHROPIC_BASE_URL=https://internal-apigw-kr.hmg-corp.io/hchat-in/api/v3/claude/messages

# 운영자 이메일 (오류 알림 수신 + 모든 Jira 알림 CC)
# GitHub clone 후 본인 이메일로 변경할 것
ANALYST_OWNER_EMAIL=your-email@innocean.com

# Jira 커스텀 필드 ID (기본값 사용 시 아래 항목 불필요 — config.py 참조)
# JIRA_FIELD_COUNTRY=customfield_10175
# JIRA_FIELD_BRD_STATUS=customfield_10101
# JIRA_FIELD_FEATURE_TYPE=customfield_10102
